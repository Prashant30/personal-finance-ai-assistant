{
  "name": "Personal Finance AI Assistant",
  "image": "mcr.microsoft.com/devcontainers/java:1-25-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "installMaven": true,
      "mavenVersion": "3.9.11"
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Finance API"
    }
  },
  "postCreateCommand": "mkdir -p runtime && ./mvnw -q -DskipTests dependency:go-offline",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot",
        "redhat.vscode-yaml"
      ]
    }
  }
}

